# TRACECRAFT 生产环境变量（复制为 .env 后修改；勿提交 Git）

NODE_ENV=production
PORT=4318
DIP_DATA_DIR=.data

# 模型（可选；不配则演示模式，也可登录后在「模型设置」配置）
# OPENAI_API_KEY=your-api-key
# 也可在页面设置 baseUrl / model

# 账号（首次启动 seed 用；已有 .data/db.json 后改这里不会覆盖已有用户）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=请改成强密码
USER_USERNAME=user
USER_PASSWORD=请改成强密码
